# Non-secret values declared in catalog/env.yaml.
# Secrets (secret: true in that table) go in the OS keychain:
#   uv run goat env set NAME
#   uv run goat jira login          # JIRA_API_TOKEN
#   uv run goat figma login         # FIGMA_ACCESS_TOKEN (optional)
# See catalog/env.yaml to add more rows. Never put values in that file.
#
# Create a Jira token using docs/jira-api-token.md
# https://id.atlassian.com/manage-profile/security/api-tokens
#
# JIRA_API_TOKEN here is a fallback for CI or machines without a keychain.
#
# Do not source this file in your shell and do not paste these values into chat.
# The goat CLI loads .env in-process. Copilot should only run `uv run goat`.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

# Optional. Figma personal access token for `goat figma images`.
# Prefer `uv run goat figma login` (OS keychain). See docs/figma-access-token.md.
# FIGMA_ACCESS_TOKEN=

# Optional. Override auto-detection of this repository root (the Python CLI).
# This does not make `uv run` find the project. After cd into a sibling, use
# `uv run --project /absolute/path/to/goat goat …` or scripts/goat.sh.
# GOAT_ROOT=/absolute/path/to/goat
