{
  "folders": [
    {
      "name": "goat",
      "path": ".."
    },
    {
      "name": "frontend",
      "path": "../../frontend"
    },
    {
      "name": "backend",
      "path": "../../backend"
    },
    {
      "name": "mobile",
      "path": "../../mobile"
    },
    {
      "name": "infra",
      "path": "../../infra"
    }
  ],
  "settings": {
    "git.autoRepositoryDetection": true,
    "git.detectSubmodules": false,
    "git.repositoryScanMaxDepth": 1,
    "git.openRepositoryInParentFolders": "never",
    "github.copilot.chat.codeGeneration.useInstructionFiles": true,
    "chat.useCustomizationsInParentRepositories": true,
    "terminal.integrated.env.linux": {
      "GOAT_ROOT": "${workspaceFolder:goat}",
      "GOAT_WORKSPACE": "platform",
      "GOAT_WORKSPACE_FILE": "${workspaceFile}"
    },
    "terminal.integrated.env.osx": {
      "GOAT_ROOT": "${workspaceFolder:goat}",
      "GOAT_WORKSPACE": "platform",
      "GOAT_WORKSPACE_FILE": "${workspaceFile}"
    },
    "terminal.integrated.env.windows": {
      "GOAT_ROOT": "${workspaceFolder:goat}",
      "GOAT_WORKSPACE": "platform",
      "GOAT_WORKSPACE_FILE": "${workspaceFile}"
    }
  },
  "extensions": {
    "recommendations": [
      "GitHub.copilot",
      "GitHub.copilot-chat"
    ]
  },
  "goat": {
    "id": "platform",
    "name": "Platform",
    "description": "Cross-cutting work across the full stack",
    "personal": false,
    "folders": [
      "frontend",
      "backend",
      "mobile",
      "infra"
    ],
    "tags": [
      "ui",
      "api",
      "mobile",
      "infra"
    ],
    "include_goat": true
  }
}
