{
  "folders": [
    {
      "name": "goat",
      "path": ".."
    },
    {
      "name": "frontend",
      "path": "../../frontend"
    },
    {
      "name": "backend",
      "path": "../../backend"
    }
  ],
  "settings": {
    "git.autoRepositoryDetection": true,
    "git.detectSubmodules": false,
    "git.repositoryScanMaxDepth": 1,
    "git.openRepositoryInParentFolders": "never",
    "github.copilot.chat.codeGeneration.useInstructionFiles": true,
    "chat.useCustomizationsInParentRepositories": true,
    "terminal.integrated.env.linux": {
      "GOAT_ROOT": "${workspaceFolder:goat}",
      "GOAT_WORKSPACE": "frontend",
      "GOAT_WORKSPACE_FILE": "${workspaceFile}"
    },
    "terminal.integrated.env.osx": {
      "GOAT_ROOT": "${workspaceFolder:goat}",
      "GOAT_WORKSPACE": "frontend",
      "GOAT_WORKSPACE_FILE": "${workspaceFile}"
    },
    "terminal.integrated.env.windows": {
      "GOAT_ROOT": "${workspaceFolder:goat}",
      "GOAT_WORKSPACE": "frontend",
      "GOAT_WORKSPACE_FILE": "${workspaceFile}"
    }
  },
  "extensions": {
    "recommendations": [
      "GitHub.copilot",
      "GitHub.copilot-chat"
    ]
  },
  "goat": {
    "id": "frontend",
    "name": "Frontend",
    "description": "UI work with API types available for contract changes",
    "personal": false,
    "folders": [
      "frontend",
      "backend"
    ],
    "tags": [],
    "include_goat": true
  }
}
